# Copie para deploy/.env.production (ignorado pelo Git) e preencha com valores próprios.
# Gere segredos longos e aleatórios; nunca reutilize credenciais de outros projetos.

# Versão das imagens: o publish.sh usa o commit atual.
ORGANIZALI_VERSION=

# Endereço público (D16: domínio a definir). APP_ORIGIN e o link do e-mail usam este valor exato.
ORGANIZALI_PUBLIC_ORIGIN=https://financas.exemplo.com.br
ORGANIZALI_SITE_ADDRESS=financas.exemplo.com.br
# E-mail para o certificado automático (Let's Encrypt) ou "internal" para certificado local de teste.
ORGANIZALI_TLS=voce@exemplo.com.br
ORGANIZALI_HTTP_PORT=80
ORGANIZALI_HTTPS_PORT=443

ORGANIZALI_DB_PASSWORD=
ORGANIZALI_DB_ROOT_PASSWORD=
# Pelo menos 32 caracteres.
ORGANIZALI_JWT_KEY=

# Recuperação de senha (opcional até a escolha do provedor em D16). Sem host, o recurso responde "indisponível".
ORGANIZALI_SMTP_HOST=
ORGANIZALI_SMTP_PORT=587
ORGANIZALI_SMTP_SSL=true
ORGANIZALI_SMTP_USER=
ORGANIZALI_SMTP_PASSWORD=
ORGANIZALI_SMTP_FROM=

# Backup: se definido, o arquivo é cifrado com AES-256 (openssl). Guarde a senha fora do servidor.
ORGANIZALI_BACKUP_PASSPHRASE=
